# =============================================================================
#  CHALKLINE - ENVIRONMENT VARIABLES
#
#  Copy this to ".env" for your own notes, and set the same names in your
#  hosting platform's "Environment" or "Configuration" section.
#
#  Nothing here is read automatically: Spring Boot reads real environment
#  variables. This file is the checklist of what to set.
#
#  NEVER commit a filled-in .env. .gitignore already excludes it.
# =============================================================================

# --- DATABASE ----------------------------------------------------------------
# Leave all three unset for local development and the app uses an H2 file under
# ./data. For anything real, point these at managed PostgreSQL.
#
# Careful: platforms often give you  postgres://user:pass@host:5432/db
# That is NOT a JDBC URL. Rewrite it as below and split out the credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/chalkline
DATABASE_USERNAME=chalkline
DATABASE_PASSWORD=

# Hibernate schema handling: update (default) | validate | none
DATABASE_DDL_AUTO=update
DATABASE_POOL_SIZE=10

# --- PUBLIC ADDRESS ----------------------------------------------------------
# How the world reaches this deployment. Used to build share links, calendar
# subscription URLs and Stripe return URLs, so it MUST be the real public
# address in production or those links will point at localhost.
PUBLIC_URL=https://timetable.your-university.edu

# --- BRANDING ----------------------------------------------------------------
PRODUCT_NAME=Chalkline
SUPPORT_EMAIL=timetable@your-university.edu

# --- ACCOUNTS ----------------------------------------------------------------
# true  = anyone who can reach the site can create a new institution
# false = single-institution deployment; nobody can sign up
ALLOW_SIGN_UP=true
MIN_PASSWORD_LENGTH=8

SESSION_TIMEOUT=8h
# MUST be true in production so the session cookie only travels over HTTPS.
SESSION_COOKIE_SECURE=true

# --- BILLING (Stripe) --------------------------------------------------------
# Leave STRIPE_SECRET_KEY blank and billing is switched off: everyone stays on
# the free plan and the upgrade buttons explain that payments are not set up.
# That is the right setting for a university-hosted deployment.
#
# To take payments, from your Stripe dashboard:
#   1. Products -> add a product with a recurring monthly price -> copy price_...
#   2. Developers -> API keys -> copy sk_...
#   3. Developers -> Webhooks -> add endpoint PUBLIC_URL/billing/webhook
#      listening for checkout.session.completed and customer.subscription.*
#      -> copy whsec_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Lets an admin switch their own institution to Premium with no payment, so
# premium features can be demonstrated before Stripe exists. Refused whenever
# Stripe IS configured, so it can never become a way around paying.
ALLOW_MANUAL_UPGRADE=false

# --- DEMO DATA ---------------------------------------------------------------
# Fills a brand-new institution with a few sample rooms and courses.
SEED_STARTER_CATALOGUE=true

# Creates one demo institution at first start, and ONLY when the database is
# completely empty. Leave the email blank to create nothing.
DEMO_ORG_EMAIL=
DEMO_ORG_PASSWORD=
DEMO_ORG_NAME=Demo University

# --- PLATFORM ----------------------------------------------------------------
# Set automatically by most platforms. Do not hard-code in production.
PORT=8080
SPRING_PROFILES_ACTIVE=prod
TEMPLATE_CACHE=true
LOG_LEVEL=INFO

# =============================================================================
#  NOT WIRED UP YET - see the commented blocks at the bottom of
#  src/main/resources/application.yml for how to switch these on.
# =============================================================================

# --- EMAIL (needed for "forgot my password" and invitations) ------------------
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- SINGLE SIGN-ON (staff use their existing university account) -------------
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_TENANT_ID=
